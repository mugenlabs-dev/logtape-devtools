{
  "name": "logtape-devtools",
  "private": true,
  "scripts": {
    "audit": "pnpm audit --audit-level=moderate",
    "build": "pnpm --filter ./packages/core run build",
    "build-storybook": "pnpm --filter ./packages/core run build-storybook",
    "changeset": "changeset",
    "clean": "pnpm -r run clean",
    "dev": "pnpm --filter ./packages/core run dev",
    "dev:demo": "pnpm --filter demo run dev",
    "generate:og": "tsx scripts/generate-og-image.tsx",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "storybook": "pnpm --filter ./packages/core run storybook",
    "test": "vitest --project=unit",
    "test:ci": "vitest run --project=unit --passWithNoTests",
    "test:e2e": "playwright test",
    "test-storybook": "vitest run --project=storybook",
    "typecheck": "pnpm build && tsgo -p packages/core --noEmit && tsgo -p apps/demo --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-vitest": "^10.6.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260412.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "jsdom": "^26.1.0",
    "satori": "^0.26.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "ultracite": "^7.10.7",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
