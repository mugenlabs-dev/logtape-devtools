{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "./node_modules/ultracite/config/biome/core/biome.jsonc",
    "./node_modules/ultracite/config/biome/react/biome.jsonc"
  ],
  "formatter": {
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredVariables": "off"
      },
      "suspicious": {
        "noDoubleEquals": "off",
        // `x != null` is the project idiom for null-or-undefined checks
        "noEqualsToNull": "off",
        // Misfires on ref.current and other values Biome cannot narrow
        "noUnnecessaryConditions": "off"
      },
      "complexity": {
        "noVoid": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noBarrelFile": "off",
        // Inline handlers in JSX are fine at this app's scale
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      // Playwright tests and Storybook play functions await steps sequentially on purpose
      "includes": ["e2e/**", "**/*.stories.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      // Animated icons vendored from the lucide-animated shadcn registry.
      // Kept close to upstream so they can be re-fetched without re-editing.
      // They wrap a decorative <svg> in a hover-listening <div>; the real
      // accessible name always lives on the surrounding button/link.
      "includes": ["apps/demo/src/icons/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "noStaticElementInteractions": "off",
            "noSvgWithoutTitle": "off"
          },
          "suspicious": {
            "noReactForwardRef": "off"
          }
        }
      }
    }
  ]
}
